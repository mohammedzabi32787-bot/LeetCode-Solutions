import java.util.*;
// find the mean of 6 Numbers
public class Main {
    public static void main (String[] args) {
      Scanner sc = new Scanner(System.in);
      int a = sc.nextInt();
      int b = sc.nextInt();
      int c = sc.nextInt();
      int d = sc.nextInt();
      int e = sc.nextInt();
      int f = sc.nextInt(); 

      int x = (a+b+c+d+e+f)/6;
      System.out.print("The mean is:" + x );
    }
}
